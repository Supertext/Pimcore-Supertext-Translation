# Defaults for the Supertext demo. Real values come from the environment (Railway variables,
# docker run -e …) or from .env.local, which is never committed. See demo/.env.example.
APP_ENV=prod
APP_DEBUG=false
PIMCORE_DEV_MODE=false

DATABASE_URL=mysql://pimcore:pimcore@127.0.0.1:3306/pimcore?serverVersion=mariadb-10.11.14
PIMCORE_OPENSEARCH_DSN=opensearch://127.0.0.1:9200?ssl=false
PIMCORE_MESSENGER_TRANSPORT_DSN_PREFIX=doctrine://default?queue_name=

MERCURE_JWT_KEY=
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_SERVER_URL=http://127.0.0.1:3000/.well-known/mercure

APPLICATION_SECRET=
PIMCORE_ENCRYPTION_SECRET=
PIMCORE_INSTANCE_IDENTIFIER=
PIMCORE_PRODUCT_KEY=
