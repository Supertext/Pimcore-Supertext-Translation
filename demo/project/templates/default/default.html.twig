{# Supertext demo page: editable headline, intro, content and link, with a language switcher. #}
{% set language = document.getProperty('language') ?: 'en' %}
<!DOCTYPE html>
<html lang="{{ language|replace({'_': '-'}) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.title ?: document.key }} – Supertext Pimcore Demo</title>
    {% if document.description %}<meta name="description" content="{{ document.description }}">{% endif %}
    <style>
        body { font: 17px/1.6 system-ui, sans-serif; margin: 0; color: #1f2933; background: #f7f8fa; }
        header, main, footer { max-width: 720px; margin: 0 auto; padding: 16px 20px; }
        header { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
        header a { color: inherit; text-decoration: none; }
        .brand { font-weight: 600; }
        .languages { list-style: none; display: flex; gap: 12px; margin: 0; padding: 0; }
        .languages a { color: #52606d; }
        .languages .current a { color: #e2001a; font-weight: 600; }
        article { background: #fff; border-radius: 8px; padding: 24px 28px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .intro { font-size: 19px; color: #3e4c59; }
        .cta a { display: inline-block; background: #e2001a; color: #fff; padding: 8px 16px; border-radius: 6px; text-decoration: none; }
        footer { color: #7b8794; font-size: 14px; }
    </style>
</head>
<body>
<header>
    <span class="brand">Supertext Pimcore Demo</span>
    <ul class="languages">
        {% for item in languages|default([]) %}
            <li{% if item.current %} class="current"{% endif %}><a href="{{ item.url }}" hreflang="{{ item.hreflang }}">{{ item.label }}</a></li>
        {% endfor %}
    </ul>
</header>
<main>
    <article>
        <h1>{{ pimcore_input('headline', { placeholder: 'Headline' }) }}</h1>
        <p class="intro">{{ pimcore_textarea('intro', { placeholder: 'Introduction', nl2br: true }) }}</p>
        {{ pimcore_wysiwyg('content') }}
        <p class="cta">{{ pimcore_link('cta') }}</p>
    </article>
</main>
<footer>Demo of <a href="https://github.com/Supertext/Pimcore-Supertext-Translation">Supertext Translation for Pimcore</a>.</footer>
</body>
</html>
