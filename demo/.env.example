# Supertext Translation for Pimcore: demo variables.
# On Railway these are service variables; locally pass them with `docker run --env-file`.
# Never commit real values.

# --- Supertext ---------------------------------------------------------------
# No Supertext account yet? Create one at supertext.com:
#   https://www.supertext.com/person/en/account/signin
# Generate your API key at supertext.com → Integrations → API (requires the Admin role):
#   https://www.supertext.com/en/integrations/api
SUPERTEXT_API_KEY=
# Only for tests against a stand-in API (leave empty for the live API).
SUPERTEXT_API_URL=
# Optional: another review service for languages with "Translation review" ticked on
# Supertext → Settings (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# "Send version information to Supertext" (on by default): the site URL and the bundle, Pimcore,
# PHP and SDK versions, whether a key is set and the API key check go to the Supertext Commando
# Center after an update and when the key changes. No content, no API key, no personal data.
# 0 (or false/off/no) turns it off; the public /supertext/ping then answers 404.
SUPERTEXT_VERSION_REPORTS=
# Only for tests: send version reports to a stand-in instead of the Commando Center.
SUPERTEXT_REPORT_URL=

# --- Demo accounts (created on every start if missing, never changed) ----------
# Replace Pimcore's installer admin: with DEMO_ADMIN_* set, the first install uses that account.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Role "Editors": documents, data objects, all languages, "Translate with Supertext".
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# --- Database (MySQL 8 or MariaDB 10.11+) --------------------------------------
# Railway: reference the MySQL service, e.g. MYSQL_URL=${{MySQL.MYSQL_URL}}
MYSQL_URL=
# The demo uses its own database on that server and creates it if needed.
PIMCORE_DB_NAME=pimcore
# MySQL: 8.0.0 · MariaDB: e.g. mariadb-10.11.14
PIMCORE_DB_SERVER_VERSION=8.0.0

# --- OpenSearch 2.x (Pimcore Studio's search index) ----------------------------
# Railway: opensearch://${{OpenSearch.RAILWAY_PRIVATE_DOMAIN}}:9200?ssl=false (security plugin off, private network only)
PIMCORE_OPENSEARCH_DSN=opensearch://opensearch.railway.internal:9200?ssl=false

# --- Pimcore product registration (free Community Edition) --------------------
# Register the instance at https://license.pimcore.com/register with the identifier and
# the hash of the secret; the three values belong together.
PIMCORE_ENCRYPTION_SECRET=
PIMCORE_INSTANCE_IDENTIFIER=
PIMCORE_PRODUCT_KEY=

# --- Secrets (any long random strings; keep them stable) -----------------------
APPLICATION_SECRET=
MERCURE_JWT_KEY=

# Public address, if it isn't Railway's RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
