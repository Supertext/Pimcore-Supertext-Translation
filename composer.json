{
    "name": "supertext/pimcore-supertext-translation",
    "description": "Supertext AI translation for Pimcore Studio: translate documents and data objects into the other languages.",
    "type": "pimcore-bundle",
    "license": "MIT",
    "keywords": ["pimcore", "pimcore-bundle", "studio", "translation", "supertext", "machine translation", "localization"],
    "authors": [{ "name": "Supertext AG", "email": "support@supertext.com", "homepage": "https://www.supertext.com" }],
    "homepage": "https://github.com/Supertext/Pimcore-Supertext-Translation",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "pimcore/pimcore": "^2026.1",
        "pimcore/studio-backend-bundle": "^2026.1",
        "pimcore/studio-ui-bundle": "^2026.1",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Supertext\\PimcoreTranslationBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Supertext\\PimcoreTranslationBundle\\Tests\\": "tests/" }
    },
    "extra": {
        "pimcore": { "bundles": ["Supertext\\PimcoreTranslationBundle\\SupertextTranslationBundle"] }
    },
    "archive": { "exclude": ["/assets/node_modules", "/demo", "/tests", "/docs"] }
}
